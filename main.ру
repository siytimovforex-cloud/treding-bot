import os
from flask import Flask, request
import requests

app = Flask(__name__)

# Render'da "Environment Variables" qismiga qo'shasiz
API_TOKEN = os.environ.get('8849499948:AAHtZ-qZSfdIGiLvsrtft50RTr6WVSCHdrY')
CHAT_ID = os.environ.get('1811630539')

@app.route('/webhook', methods=['POST'])
def webhook():
    data = request.get_json(force=True)
    if data:
        symbol = data.get('symbol', 'Noma\'lum')
        price = data.get('price', 'N/A')
        message = f"Trading signal:\nSymbol: {symbol}\nPrice: {price}"
        
